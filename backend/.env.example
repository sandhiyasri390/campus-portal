PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus_placement
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: only used if you want real emails, app works fine without these
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Campus Placement Portal <no-reply@campusplacement.com>

# Optional: only used if you want AI-powered resume/readiness analysis
AI_API_KEY=
